# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Port
PORT=3001

# Neon Serverless PostgreSQL (Pooled connection for serverless & production queries)
DATABASE_URL="postgresql://user:password@ep-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Neon Serverless PostgreSQL (Direct connection for Prisma migrations and schema push)
DIRECT_URL="postgresql://user:password@ep.region.aws.neon.tech/neondb?sslmode=require"

# Gmail SMTP Emergency Dispatch Configuration
GMAIL_USER="your_email@gmail.com"
GMAIL_APP_PASS="your_gmail_app_password"
